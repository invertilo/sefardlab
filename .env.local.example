# Copia este archivo a .env.local y rellena los valores (ver SUPABASE_SETUP.md).
# .env.local está en .gitignore: nunca subas credenciales a Git.

# Supabase → Project Settings → API (o "Connect" → App Frameworks → Next.js)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para el script de seed (npm run db:seed). Salta RLS: NUNCA con prefijo
# NEXT_PUBLIC_ ni en el navegador. Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=
